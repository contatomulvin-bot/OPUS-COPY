# Database
DATABASE_URL="file:./dev.db"

# Gemini is used for semantic clip analysis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted/self-referential URL (optional for local desktop use)
APP_URL="http://localhost:3000"

# Clip ranking profile. Options:
# viral | education | storytelling | humor | marketing | podcast
# The default is viral.
OPUS_CONTENT_PROFILE="viral"

# Whisper configuration used by the desktop/local transcription stack.
# auto lets the runtime choose the best available device.
WHISPER_DEVICE="auto"
WHISPER_MODEL="small"
WHISPER_COMPUTE_TYPE="int8"
