# Database / legacy local services
DATABASE_URL="file:./dev.db"

# Gemini is used for semantic clip analysis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted/self-referential URL
APP_URL="https://www.mistcut.com"

# Clip ranking profile. Options:
# viral | education | storytelling | humor | marketing | podcast
OPUS_CONTENT_PROFILE="viral"

# Whisper configuration used by the desktop/local transcription stack.
WHISPER_DEVICE="auto"
WHISPER_MODEL="small"
WHISPER_COMPUTE_TYPE="int8"

# MISTCUT account / credits cloud.
# Production defaults point to the official service; override locally for development.
MISTCUT_CLOUD_API_URL="https://api.mistcut.com"
MISTCUT_WEB_URL="https://www.mistcut.com"

# Development-only escape hatch. Never ship production builds with this enabled.
MISTCUT_CLOUD_DISABLED="0"
