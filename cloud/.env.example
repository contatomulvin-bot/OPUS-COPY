DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
PORT=4100

WEB_URL="https://www.mistcut.com"
CORS_ORIGINS="https://www.mistcut.com,https://mistcut.com"
TRUST_PROXY=1
ALLOW_REGISTRATION=true

# Supabase Auth. A publishable key pode ser usada pelo backend para os endpoints públicos de Auth.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# E-mails bootstrap que devem receber SUPER_ADMIN no primeiro login.
# Configure somente no servidor, nunca no frontend.
MISTCUT_SUPER_ADMIN_EMAILS=""

# IA: segredo somente no Cloud. Nunca distribuir esta chave no .exe.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.5-flash-lite"

# Stripe: somente no backend.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_STUDIO=""
STRIPE_PRICE_AGENCY=""
STRIPE_PRICE_EXTRA_2000=""
STRIPE_PRICE_EXTRA_5000=""
STRIPE_PRICE_EXTRA_10000=""

APP_LATEST_VERSION="4.7.1"
APP_MINIMUM_VERSION="4.7.1"
APP_DOWNLOAD_URL="https://www.mistcut.com/download"
