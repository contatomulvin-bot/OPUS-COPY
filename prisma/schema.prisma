generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  CREATED
  PROCESSING
  READY
  FAILED
}

enum VideoSourceType {
  UPLOAD
  YOUTUBE
}

enum VideoStatus {
  CREATED
  DOWNLOADING
  DOWNLOADED
  EXTRACTING_AUDIO
  AUDIO_READY
  TRANSCRIBING
  TRANSCRIBED
  ANALYZING
  ANALYZED
  RENDERING
  COMPLETED
  FAILED
}

enum ClipStatus {
  CANDIDATE
  SELECTED
  RENDERING
  COMPLETED
  FAILED
}

enum RenderStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    ProjectStatus @default(CREATED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  videos    Video[]

  @@index([userId])
}

model Video {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalName String
  sourceType   VideoSourceType @default(UPLOAD)
  sourceUrl    String?
  storagePath  String
  duration     Float           @default(0)
  width        Int             @default(0)
  height       Int             @default(0)
  fileSize     BigInt          @default(0)
  audioPath    String?
  status       VideoStatus     @default(CREATED)
  currentStep  String?
  progress     Int             @default(0)
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  transcript   Transcript?
  clips        Clip[]

  @@index([projectId])
}

model Transcript {
  id        String              @id @default(uuid())
  videoId   String              @unique
  video     Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language  String              @default("pt")
  text      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  segments  TranscriptSegment[]
}

model TranscriptSegment {
  id           String           @id @default(uuid())
  transcriptId String
  transcript   Transcript       @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  startTime    Float
  endTime      Float
  text         String
  createdAt    DateTime         @default(now())
  words        TranscriptWord[]

  @@index([transcriptId])
  @@index([startTime])
}

model TranscriptWord {
  id        String            @id @default(uuid())
  segmentId String
  segment   TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  word      String
  startTime Float
  endTime   Float
  createdAt DateTime          @default(now())

  @@index([segmentId])
  @@index([startTime])
}

model Clip {
  id          String     @id @default(uuid())
  videoId     String
  video       Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  startTime   Float
  endTime     Float
  title       String
  description String
  hook        String
  category    String     @default("OTHER")
  score       Int        @default(0)
  scores      String?
  status      ClipStatus @default(CANDIDATE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  renders     Render[]

  @@index([videoId])
  @@index([score])
}

model Render {
  id           String       @id @default(uuid())
  clipId       String
  clip         Clip         @relation(fields: [clipId], references: [id], onDelete: Cascade)
  status       RenderStatus @default(QUEUED)
  options      String?
  progress     Int          @default(0)
  currentStep  String?
  outputPath   String?
  errorMessage String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([clipId])
}
